.env
font/
__pycache__/
*.pyc
ket_qua/
.venv/
/work/
/cache/
# data/: bỏ qua ảnh và PDF, giữ lại metadata, nhãn và file dóng hàng
data/*
!data/*/
data/*/*
!data/*/*/
data/*/*/*
!data/*/*/Label.txt
!data/*/*/fileState.txt
!data/*/*.xlsx
!data/*/*.csv
!data/*/align_report.txt
# Kết quả duyệt đề xuất của tab Đề xuất (lựa chọn, ứng viên đã chấm, thống kê): giữ lại để làm tiếp trên máy khác
!data/*/review_state.json
!data/*/candidates_cache.json
!data/*/ranker_cache.json
!data/*/statistics.json
# Cache của từng sách: data/<Tên sách>/cache/*.json (phan_loai.json, ocr_log.json) và
# data/<Tên sách>/cache/ocr/<engine>/<NNN>.json (kết quả OCR thô). KHÔNG lấy ảnh: cache/pages/, cache/thumbs/,
# và ảnh debug của row_projection (cache/ocr/row_projection/<NNN>/).
!data/*/cache/
data/*/cache/*
!data/*/cache/*.json
!data/*/cache/ocr/
data/*/cache/ocr/*
!data/*/cache/ocr/*/
data/*/cache/ocr/*/*
!data/*/cache/ocr/*/*.json
# Cache dùng chung: data/cache/ (giữ thư mục bằng .gitkeep)
!data/cache/.gitkeep
!data/cache/type.json
!data/cache/uploads.json
# Từ điển dựng từ Unihan (scripts/nom_dict.py build): giữ file .json, bỏ file zip tải về
!data/cache/dict/
data/cache/dict/*
!data/cache/dict/*.json
